# Real configuration, backups and all generated cases belong outside this tree.
*
!.gitignore
!.gitattributes
!README.md
!AGENTS.md
!LICENSE
!THIRD_PARTY_NOTICES.md
!SECURITY.md
!CHANGELOG.md
!requirements.txt
!wxlocal.py
!scripts/
!scripts/*.py
!tests/
!tests/*.py
!tools/
!tools/*.py
!tools/upstream-lock.json
!docs/
!docs/*.md
!examples/
!examples/config.example.json
!.github/
!.github/workflows/
!.github/workflows/test.yml
__pycache__/
*.pyc
.venv/
